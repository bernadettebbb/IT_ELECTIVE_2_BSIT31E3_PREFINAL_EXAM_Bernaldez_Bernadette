@model IEnumerable<PREFINAL_EXAM.Models.ExamItem>

@{
    ViewData["Title"] = "Prefinal Exam";
}

<style>
    .exam-card {
        border: none;
        border-radius: 12px;
        transition: transform 0.2s ease-in-out;
        background: #f8f9fa;
    }
    .exam-card:hover {
        transform: translateY(-4px);
    }
    .item-badge {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
    .answer-box {
        background-color: #e8f5e9;
        border-left: 4px solid #198754;
        border-radius: 4px;
        padding: 10px 14px;
    }
</style>

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">IT Elective 2 Prefinal Reviewer</h1>
        <p class="text-muted">Simple & Clean Exam Questions Overview</p>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-6">
                <div class="card exam-card shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <span class="badge bg-primary item-badge mb-2">Item @item.Id</span>
                            <h5 class="card-title fw-semibold text-dark mt-2 mb-3">@item.Question</h5>
                        </div>
                        <div class="answer-box mt-3">
                            <span class="fw-bold text-success d-block mb-1">Answer:</span>
                            <span class="text-dark fw-medium">@item.Answer</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>