@model IEnumerable<PREFINAL_EXAM.Models.ExamItem>

@{
    ViewData["Title"] = "Prefinal Exam";
}

<style>
    body {
        background-color: #fdf6f7;
    }

    .reviewer-title {
        color: #b85b75;
    }

    .exam-card {
        border: 1px solid #f3d5dc;
        border-radius: 14px;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        background: #ffffff;
    }

        .exam-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(184, 91, 117, 0.12) !important;
        }

    .item-badge {
        background-color: #c25975 !important;
        color: #ffffff !important;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .answer-box {
        background-color: #f7faf7;
        border-left: 4px solid #8fad92;
        border-radius: 6px;
        padding: 10px 14px;
    }

    .answer-label {
        color: #58795c;
    }
</style>

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold reviewer-title">IT Elective 2 Prefinal Exam</h1>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-6">
                    <div class="card exam-card shadow-sm h-100">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <span class="badge item-badge mb-2">Item @item.Id</span>
                                <h5 class="card-title fw-semibold text-dark mt-2 mb-3">@item.Question</h5>
                            </div>
                            <div class="answer-box mt-3">
                                <span class="fw-bold answer-label d-block mb-1">Answer:</span>
                                <span class="text-dark fw-medium">@item.Answer</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-danger">No questions available to display.</p>
            </div>
        }
    </div>
</div>